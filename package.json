{
  "name": "wiztree-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for WizTree CSV exports and disk usage analysis.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "wiztree-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "print-config": "node scripts/print-config.mjs"
  },
  "keywords": [
    "mcp",
    "wiztree",
    "disk-usage"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "csv-parse": "^5.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
